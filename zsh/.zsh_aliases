# ubuntu
alias update="sudo apt update"
alias upgrade="sudo apt upgrade"
alias autoremove="sudo apt autoremove"

# python
alias python="python3"
alias activate=". ./ENV/bin/activate"

# git
alias status="git status"
alias add="git add"
alias commit="git commit"
alias push="git push"
alias pull="git pull"
alias checkout="git checkout"
alias clone="git clone"
alias branch="git branch"
alias switch="git switch"
alias fetch="git fetch"
alias merge="git merge"

# node
alias start="yarn start"
alias dev="yarn dev"
alias build="yarn build"

# gcloud
alias default-login="gcloud auth application-default login"
alias projects="gcloud projects list"
alias set-project="gcloud config set project"
alias get-project="gcloud config get-value project"
alias instances="gcloud compute instances list"
